<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@android:id/background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/widget_background_light" android:scaleType="fitXY"
        android:importantForAccessibility="no" android:contentDescription="@null" />
    <LinearLayout android:id="@+id/widget_stack"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/widget_header"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:id="@+id/widget_open"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:focusable="true" android:importantForAccessibility="yes">
                <TextView android:id="@+id/widget_title"
                    android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                    android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"
                    android:text="忘了没" android:textSize="14sp" android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_light_text" android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_count"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:maxLines="1"
                    android:textSize="12sp" android:textColor="@color/widget_light_secondary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <FrameLayout android:id="@+id/widget_header_add"
                android:layout_width="36dp" android:layout_height="match_parent"
                android:layout_marginStart="8dp" android:minHeight="36dp" android:visibility="gone">
                <ImageView android:id="@+id/widget_add_icon"
                    android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                    android:src="@drawable/ic_widget_add" android:contentDescription="@null"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
        <TextView android:id="@+id/widget_gap"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/widget_body"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/widget_rows"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" />
            <TextView android:id="@+id/widget_empty"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end"
                android:text="清单空空，想到就记" android:textSize="14sp"
                android:textColor="@color/widget_light_secondary" android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:id="@+id/widget_footer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_add"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:minWidth="36dp" android:gravity="center_vertical" android:maxLines="1"
                android:ellipsize="end" android:text="＋ 记一条" android:textSize="14sp"
                android:textColor="@color/widget_light_primary" />
            <TextView android:id="@+id/widget_more"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:minWidth="36dp" android:maxWidth="156dp" android:layout_marginStart="8dp"
                android:gravity="end|center_vertical" android:maxLines="1" android:ellipsize="end"
                android:text="查看全部 ›" android:textSize="12sp" android:textColor="@color/widget_light_primary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
